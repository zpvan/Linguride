{
  "manifest_version": 3,
  "name": "Lingride - 双语翻译",
  "description": "英文网页双语对照翻译扩展，保留原文同时显示中文翻译",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Lingride 翻译"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "css": ["src/content/styles.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://*.openai.com/*",
    "https://chatgpt.com/*",
    "https://api.xiaomimimo.com/*",
    "https://api.minimax.io/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/permissions/permissions.html",
        "src/tutor/tutor.html",
        "src/corpus/corpus.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
