{
  "manifest_version": 3,
  "name": "Lingride",
  "description": "英文网页双语对照翻译扩展，保留原文同时显示中文翻译",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "114",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Lingride"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开/关闭 Lingride 侧边栏"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "css": ["src/content/styles.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "clipboardWrite",
    "offscreen",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.deepseek.com/*",
    "https://*.openai.com/*",
    "https://chatgpt.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.xiaomimimo.com/*",
    "https://api.minimax.cn/*",
    "https://api.minimaxi.com/*",
    "https://openspeech.bytedance.com/*",
    "wss://openspeech.bytedance.com/*"
  ]
}
