{
  "name": "linguride-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install:browser-extension": "npm install --workspace apps/browser-extension",
    "dev:browser-extension": "npm run dev --workspace apps/browser-extension",
    "typecheck:browser-extension": "npm run typecheck --workspace apps/browser-extension",
    "lint:browser-extension": "npm run lint --workspace apps/browser-extension",
    "build:browser-extension": "npm run build --workspace apps/browser-extension",
    "install:desktop": "npm install --workspace apps/desktop",
    "dev:desktop": "npm run dev --workspace apps/desktop",
    "build:desktop": "npm run build --workspace apps/desktop",
    "preview:desktop": "npm run preview --workspace apps/desktop",
    "tauri:desktop": "npm --workspace apps/desktop run tauri --",
    "tauri:dev:desktop": "npm --workspace apps/desktop run tauri -- dev",
    "tauri:build:desktop": "npm --workspace apps/desktop run tauri -- build",
    "install:vscode": "npm install --workspace apps/vscode-extension",
    "compile:vscode": "npm run compile --workspace apps/vscode-extension",
    "watch:vscode": "npm run watch --workspace apps/vscode-extension",
    "lint:vscode": "npm run lint --workspace apps/vscode-extension",
    "test:vscode": "npm run test --workspace apps/vscode-extension",
    "package:vscode": "npm run package --workspace apps/vscode-extension"
  }
}
